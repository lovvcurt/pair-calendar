# Supabase Dashboard → Project Settings → API
# These are public client values. Never put a service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=PASTE_PUBLIC_VAPID_KEY_HERE
# Public Telegram Login client ID from @BotFather (safe to include in the site build).
VITE_TELEGRAM_LOGIN_CLIENT_ID=
